							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"branch_id\": {{branch_id}},\n    \"category_id\": {{category_id}},\n    \"type\": \"raw_material\",\n    \"name\": \"Minced Beef (80/20 Blend)\",\n    \"sku\": \"RM-BEEF-001\",\n    \"quantity\": 100.0,\n    \"unit\": \"kg\",\n    \"purchase_price\": 4.50,\n    \"minimum_stock\": 15.0,\n    \"description\": \"Fresh raw minced beef for burger preparation\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/inventory-items",
							"host": ["{{base_url}}"],
							"path": ["inventory-items"]
						}
					}
				},
