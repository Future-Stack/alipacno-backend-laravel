									"key": "branch_id",
									"value": "{{branch_id}}"
								}
							]
						}
					}
				},
				{
					"name": "Create Inventory Category",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"branch_id\": {{branch_id}},\n    \"name\": \"Raw Meat & Poultry\",\n    \"description\": \"Fresh uncooked meats, beef, chicken, patties\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/inventory-categories",
							"host": ["{{base_url}}"],
							"path": ["inventory-categories"]
