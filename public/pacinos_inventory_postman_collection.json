							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"branch_id\": {{branch_id}},\n    \"category_id\": {{category_id}},\n    \"type\": \"prepared\",\n    \"name\": \"Burger Patties (4oz)\",\n    \"sku\": \"PR-PATTY-001\",\n    \"made_from_item_id\": {{raw_item_id}},\n    \"pack_size\": 7.0,\n    \"pack_unit\": \"kg\",\n    \"yield_qty\": 50.0,\n    \"yield_unit\": \"pcs\",\n    \"quantity\": 0.0,\n    \"unit\": \"pcs\",\n    \"purchase_price\": 1.20,\n    \"selling_price\": 2.50,\n    \"minimum_stock\": 40.0,\n    \"description\": \"4oz prepared patties. Ratio: 7kg raw beef yields 50 patties.\"\n}"
