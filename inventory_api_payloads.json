    {
      "module_name": "6. Recipes & Bill of Materials (BOM)",
      "description": "Link menu items to inventory ingredients so POS & online orders automatically deduct raw materials.",
      "endpoints": [
        {
          "name": "List Recipes",
          "method": "GET",
